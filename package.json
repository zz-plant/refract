{
  "name": "refract",
  "version": "0.6.2",
  "type": "module",
  "private": true,
  "description": "git log for Wikipedia. See how a page's sentences, citations, and structure changed, revision by revision.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/refract-org/refract.git"
  },
  "homepage": "https://github.com/refract-org/refract#readme",
  "bugs": "https://github.com/refract-org/refract/issues",
  "keywords": [
    "observation-engine",
    "knowledge-change",
    "public-knowledge",
    "edit-history",
    "wikipedia",
    "evidence-graph",
    "agent-tool",
    "provenance",
    "semantic-events"
  ],
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=20.0.0"
  },
  "license": "AGPL-3.0",
  "workspaces": [
    "packages/evidence-graph",
    "packages/ingestion",
    "packages/analyzers",
    "packages/cli",
    "packages/mcp",
    "packages/persistence",
    "packages/eval",
    "apps/docs",
    "apps/ui"
  ],
  "scripts": {
    "build": "tsc -b",
    "lint": "biome lint packages/",
    "format": "biome format --write packages/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ci": "bun run build && biome ci packages/ && bun run typecheck && bun run check:boundaries && bun run test && bun run check:release -- --pack",
    "check:boundaries": "bun scripts/check-boundaries.ts",
    "check:examples": "bun scripts/capture-onboarding.ts --check && bun scripts/capture-review.ts --check && bun scripts/capture-wiki-examples.ts --check",
    "check:release": "bun scripts/check-release.ts",
    "clean": "rm -rf packages/*/dist",
    "postinstall": "mkdir -p node_modules/@refract-org && for pkg in packages/*/; do name=$(basename $pkg); ln -sfn ../../packages/$name node_modules/@refract-org/$name 2>/dev/null; done",
    "prepare": "husky",
    "setup": "mise trust && bun install",
    "assets:check": "bun run scripts/check-assets.ts",
    "assets:generate": "bun run scripts/generate-scenes.ts",
    "assets:brand": "bun run scripts/generate-brand-icons.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^26.6.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
